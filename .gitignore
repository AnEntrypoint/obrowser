# Generated by cargo
/target/
**/*.rs.bk
*.pdb

# Cargo.lock for libraries (keep for binary crates)
# Uncomment if this is a library-only workspace:
# Cargo.lock

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment files
.env
.env.*

# Debug files
*.d
*.o
*.so
*.dylib
*.dll

# Profiling data
flamegraph.svg
perf.data
perf.data.old

# Test artifacts
/test-results/
/coverage/

# Servo build artifacts (when full-servo feature is enabled)
/servo-build/

# gm orchestrator runtime state (heartbeats, spool in/out, watcher log) --
# memories/ and disciplines/ stay tracked per gm's own convention.
/.gm/exec-spool/
/.gm/gm.db
/.gm/gm-fired-*
